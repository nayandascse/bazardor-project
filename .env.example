# Public product API; the app tries these in order.
BAZARDOR_API_URL=https://openapi.programming-hero.com/api/bazardor
BAZARDOR_API_FALLBACK_1=https://api.api-store.workers.dev/api/bazardor
BAZARDOR_API_FALLBACK_2=https://api.abcz.workers.dev/api/bazardor

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=file:./local.db

# OAuth credentials (optional until configured with Google/GitHub console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
